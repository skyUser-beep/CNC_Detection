# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments -- NEVER commit these (this repo's original
# zip accidentally included a 1.2GB .venv/, which is why this rule
# is here in bold: don't repeat that).
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Secrets -- never commit real camera credentials
.env

# Videos / large media
*.mp4
*.avi
*.mov
*.mkv

# Model weights (share these separately, e.g. cloud storage / releases)
*.pt
*.onnx

# Local data & outputs -- keep the folders, not their contents
data/*
!data/.gitkeep
!data/videos/.gitkeep
!data/test.jpg

models/*
!models/.gitkeep

outputs/*
!outputs/.gitkeep
!output/camera_zones
!output/cameras


